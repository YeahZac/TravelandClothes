.card-hero {
  margin-top: 8rpx;
  padding: 36rpx 32rpx;
  border-radius: 32rpx;
  color: #fff;
  background: linear-gradient(145deg, #1a9e8a 0%, #0e6e7a 55%, #163a4a 100%);
  box-shadow: var(--shadow);
}

.card-hero-kicker { font-size: 22rpx; opacity: 0.85; letter-spacing: 0.12em; }
.card-hero-title { margin-top: 12rpx; font-size: 36rpx; font-weight: 800; line-height: 1.3; }
.card-hero-desc { margin-top: 12rpx; font-size: 24rpx; opacity: 0.9; line-height: 1.5; }

.quota-row {
  display: flex;
  margin-top: 20rpx;
  background: var(--paper);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
  padding: 24rpx 8rpx;
}

.quota { flex: 1; text-align: center; }
.quota-num { font-size: 36rpx; font-weight: 800; color: var(--brand-deep); }
.quota-label { margin-top: 4rpx; font-size: 22rpx; color: var(--ink-soft); }

.sku {
  background: var(--paper);
  border-radius: var(--radius-card);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-soft);
  border: 4rpx solid transparent;
}

.sku-on { border-color: var(--brand); }

.sku-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.sku-name { font-size: 32rpx; font-weight: 800; }
.sku-tag {
  display: inline-flex;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill);
  background: var(--wash);
  color: var(--brand-deep);
  font-size: 20rpx;
  font-weight: 600;
}
.sku-price { font-size: 40rpx; font-weight: 800; color: var(--brand-deep); }
.sku-unit { font-size: 22rpx; font-weight: 600; color: var(--ink-soft); }
.sku-desc { margin-top: 12rpx; font-size: 24rpx; color: var(--ink-soft); line-height: 1.5; }

.benefit { margin-top: 8rpx; }
.benefit-line { margin-top: 12rpx; font-size: 26rpx; color: var(--ink); }
