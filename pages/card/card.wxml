<nav-bar title="同袍年卡" show-back="{{true}}"></nav-bar>
<view class="page-stack has-dock">
  <view class="page-inner">
    <view class="card-hero">
      <view class="card-hero-kicker">{{holding ? '持卡生效中' : '年卡是钥匙'}}</view>
      <view class="card-hero-title">{{holding ? (card.skuName + ' · 剩 ' + card.remainScenic + ' 次景区') : '成长值永久，袍级要持卡才解锁'}}</view>
      <view class="card-hero-desc">{{holding ? ('有效期至 ' + expireText) : ('当前成长值 ' + growthValue + '，可解锁' + unlockName + '。购卡后本单景区可抵 1 次。')}}</view>
    </view>

    <view wx:if="{{holding}}" class="quota-row">
      <view class="quota" wx:for="{{quotas}}" wx:key="label">
        <view class="quota-num">{{item.value}}</view>
        <view class="quota-label">{{item.label}}</view>
      </view>
    </view>

    <view class="section-head">
      <view class="section-title">选择卡种</view>
    </view>
    <view
      wx:for="{{skus}}"
      wx:key="skuCode"
      class="sku {{current === item.skuCode ? 'sku-on' : ''}}"
      bindtap="pick"
      data-code="{{item.skuCode}}"
    >
      <view class="sku-top">
        <view>
          <view class="sku-name">{{item.name}}</view>
          <view class="sku-tag">{{item.tag}}</view>
        </view>
        <view class="sku-price">¥{{item.yuan}}<text class="sku-unit">/年</text></view>
      </view>
      <view class="sku-desc">{{item.desc}}</view>
    </view>

    <view class="card benefit">
      <view class="section-title">持卡即用</view>
      <view class="benefit-line">绿色通道、休息专区、旺季配额</view>
      <view class="benefit-line">10 次签约景区（家庭款 20 次）</view>
      <view class="benefit-line">酒店协议价、演出优选座、汉服租赁</view>
      <view class="benefit-line">去 3 个签约景区即回本</view>
    </view>
  </view>

  <view class="pay-dock">
    <view>
      <view class="pay-now">¥{{payYuan}}</view>
      <view class="note-line" wx:if="{{!trialUsed}}" bindtap="trial">7 天试用 9.9 元</view>
    </view>
    <view class="pill-btn" bindtap="buy">{{holding ? '续费年卡' : '立即开通'}}</view>
  </view>
</view>
