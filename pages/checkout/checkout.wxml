<nav-bar title="确认订单" show-back="{{true}}"></nav-bar>
<view class="page-stack checkout">
  <view class="page-inner">
    <view class="list-row">
      <view class="thumb">
        <image src="{{cover}}" mode="aspectFill" />
      </view>
      <view class="list-grow">
        <view class="list-name">{{title}}</view>
        <view class="list-meta">{{place}}</view>
      </view>
    </view>

    <view class="card check-block">
      <view class="check-row">
        <view class="check-label">使用日期</view>
        <picker mode="date" value="{{day}}" start="{{minDay}}" end="{{maxDay}}" bindchange="onDay">
          <view class="check-value">{{day}}</view>
        </picker>
      </view>
      <view class="check-row">
        <view class="check-label">购买数量</view>
        <view class="stepper">
          <view class="step" bindtap="dec">－</view>
          <view class="step-num">{{qty}}</view>
          <view class="step" bindtap="inc">＋</view>
        </view>
      </view>
    </view>

    <view class="card check-block">
      <view class="check-row">
        <view class="check-label">出行人</view>
        <input class="check-input" value="{{visitor}}" bindinput="onVisitor" placeholder="与证件姓名一致" />
      </view>
      <view class="check-row">
        <view class="check-label">手机号</view>
        <input class="check-input" type="number" maxlength="11" value="{{phone}}" bindinput="onPhone" placeholder="接收电子票" />
      </view>
    </view>

    <view class="card check-block">
      <view class="bill-row"><text>门市价</text><text>¥{{listYuan}}</text></view>
      <view wx:if="{{saveYuan}}" class="bill-row save"><text>年卡抵扣</text><text>－¥{{saveYuan}}</text></view>
      <view class="bill-row total"><text>应付</text><text>¥{{payYuan}}</text></view>
    </view>

    <view wx:if="{{hookVisible}}" class="hook" bindtap="goCard">
      <view class="hook-title">升级素袍，本单立省 ¥{{hookYuan}}</view>
      <view class="hook-desc">年卡 399 元含 10 次景区。去 3 个签约景区即回本，购卡后本单可用 1 次抵扣。</view>
    </view>
  </view>

  <view class="pay-dock">
    <view>
      <view class="pay-now">¥{{payYuan}}</view>
      <view class="note-line" wx:if="{{saveYuan}}">已用年卡抵 ¥{{saveYuan}}</view>
    </view>
    <view class="pill-btn" bindtap="submit">{{payYuan === 0 ? '确认预约' : '立即支付'}}</view>
  </view>
</view>
