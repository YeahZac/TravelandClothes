.mine-hero {
  background: linear-gradient(160deg, #21c7b1 0%, #1a9e8a 100%);
  padding: 12rpx 32rpx 40rpx;
  color: #fff;
}

.mine-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.mine-avatar-btn {
  padding: 0;
  margin: 0;
  width: 120rpx;
  min-width: 120rpx;
  max-width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  background: none;
  line-height: 1;
}

.mine-avatar-btn::after { border: none; }

.mine-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.4);
}

.mine-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.25);
  font-size: 48rpx;
  font-weight: 800;
}

.mine-name-row {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.mine-name {
  width: 100%;
  height: 56rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  text-align: left;
}

.mine-name-ph { color: rgba(255,255,255,0.72); }

.mine-robe {
  display: inline-flex;
  align-items: center;
  margin-top: 10rpx;
  padding: 6rpx 20rpx;
  min-height: 44rpx;
  border-radius: var(--radius-pill);
  background: rgba(255,255,255,0.25);
  font-size: 22rpx;
  font-weight: 600;
}

.mine-stats {
  display: flex;
  margin: 24rpx -8rpx 0;
}

.stat-item {
  flex: 1;
  min-height: 96rpx;
  text-align: center;
  padding: 8rpx;
}

.stat-value { font-size: 40rpx; font-weight: 800; font-variant-numeric: tabular-nums; }

.stat-label { font-size: 22rpx; opacity: 0.9; margin-top: 4rpx; }

.mine-growth {
  margin-top: 20rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.growth-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.growth-next { opacity: 0.9; }

.growth-bar {
  margin-top: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255,255,255,0.25);
  overflow: hidden;
}

.growth-fill {
  height: 100%;
  border-radius: 6rpx;
  background: #fff;
}

.mine-card-entry {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.16);
}

.mine-card-title { font-size: 28rpx; font-weight: 800; }
.mine-card-desc { margin-top: 6rpx; font-size: 22rpx; opacity: 0.9; }

.mine-travel-stats {
  display: flex;
  justify-content: space-around;
  background: var(--paper);
  border-radius: var(--radius-card);
  padding: 28rpx;
  margin-top: -20rpx;
  box-shadow: var(--shadow-soft);
}

.travel-stat { text-align: center; }

.travel-value { font-size: 44rpx; font-weight: 800; color: var(--brand); font-variant-numeric: tabular-nums; }

.travel-label { font-size: 22rpx; color: var(--ink-soft); margin-top: 4rpx; }

.mine-menu {
  background: var(--paper);
  border-radius: var(--radius-card);
  margin-top: 20rpx;
  box-shadow: var(--shadow-soft);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 104rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #eef1f2;
  font-size: 28rpx;
  color: var(--ink);
}

.menu-item:last-child { border-bottom: none; }

.menu-mark {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: var(--wash);
  color: var(--brand-deep);
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-arrow {
  margin-left: auto;
  width: 16rpx;
  height: 16rpx;
  border-right: 4rpx solid #c5ccd3;
  border-top: 4rpx solid #c5ccd3;
  transform: rotate(45deg);
}

.mine-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.grid-photo {
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
}

.grid-photo image { width: 100%; height: 100%; }
