.circles-tabs {
  display: flex;
  width: 100%;
}

.circle-tab {
  min-height: 72rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-soft);
}

.circle-tab-on {
  color: var(--ink);
  font-weight: 800;
  box-shadow: inset 0 -4rpx 0 var(--brand);
}

.story-scroll {
  white-space: nowrap;
  padding: 20rpx 32rpx 8rpx;
}

.story-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  width: 128rpx;
  min-height: 176rpx;
  padding: 8rpx 4rpx;
  box-sizing: border-box;
}

.story-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid var(--brand-soft);
}

.story-avatar image { width: 100%; height: 100%; }

.story-name {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink);
  font-weight: 600;
  max-width: 112rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.posts { padding: 12rpx 32rpx 0; }

.post-card {
  background: var(--paper);
  border-radius: var(--radius-card);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-soft);
}

.post-head { display: flex; align-items: center; gap: 16rpx; }

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.post-info { flex: 1; min-width: 0; }

.post-user { font-size: 28rpx; font-weight: 700; color: var(--ink); }

.post-meta { margin-top: 4rpx; font-size: 22rpx; color: var(--ink-soft); }

.post-text {
  margin: 16rpx 0;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ink);
}

.post-images.img-single .post-img {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
}

.post-images.img-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.post-images.img-grid .post-img {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
}

.post-actions {
  display: flex;
  margin: 8rpx -8rpx 0;
  padding-top: 8rpx;
  border-top: 1rpx solid #eef1f2;
}

.post-action {
  flex: 1;
  min-height: 72rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.action-liked { color: #c44757; }
.action-liked .act-like { background: #c44757; }

.act-ico {
  width: 28rpx;
  height: 28rpx;
  position: relative;
  flex-shrink: 0;
}

.act-like {
  width: 22rpx;
  height: 22rpx;
  background: currentColor;
  transform: rotate(-45deg);
  border-radius: 4rpx 4rpx 0 0;
  opacity: 0.85;
}

.act-like::before,
.act-like::after {
  content: "";
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  background: inherit;
  border-radius: 50%;
}

.act-like::before { left: -11rpx; top: 0; }
.act-like::after { left: 0; top: -11rpx; }

.act-comment {
  border: 3rpx solid currentColor;
  border-radius: 10rpx 10rpx 10rpx 4rpx;
  box-sizing: border-box;
}

.act-share {
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
  box-sizing: border-box;
}

.act-share::after {
  content: "";
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
}
