<nav-bar title="{{item.title || '活动'}}" show-back="{{true}}"></nav-bar>
<view class="page-stack" wx:if="{{item}}">
  <view class="page-inner">
    <view class="photo-hero">
      <image src="{{item.photo}}" mode="aspectFill" class="photo-fill" />
      <view class="photo-mask">
        <view class="photo-name">{{item.title}}</view>
        <view class="photo-meta">{{item.day}} · {{item.place}}</view>
      </view>
    </view>

    <view class="copy-block">
      <view class="body-copy">{{item.desc}}</view>
    </view>

    <view wx:if="{{spot}}" class="list-row" bindtap="goSpot">
      <view class="thumb">
        <image src="{{spot.photo}}" mode="aspectFill" />
      </view>
      <view class="list-grow">
        <view class="list-name">{{spot.name}}</view>
        <view class="list-meta">关联景区 · {{spot.city}}</view>
      </view>
    </view>

    <block wx:if="{{services.length}}">
      <view class="section-head">
        <view class="section-title">可搭配</view>
      </view>
      <view
        wx:for="{{services}}"
        wx:key="id"
        class="list-row"
        bindtap="goService"
        data-id="{{item.id}}"
      >
        <view class="thumb">
          <image src="{{item.photo}}" mode="aspectFill" />
        </view>
        <view class="list-grow">
          <view class="list-name">{{item.name}}</view>
          <view class="list-meta">{{item.place}}</view>
        </view>
        <view class="list-price">
          {{item.price}}
          <text class="list-price-unit">{{item.price === '0' ? '免费' : '元起'}}</text>
        </view>
      </view>
    </block>

    <view wx:if="{{garment}}" class="list-row" bindtap="goGarment">
      <view class="thumb tone-{{garment.tone}}">
        <view class="thumb-mark">{{garment.mark}}</view>
      </view>
      <view class="list-grow">
        <view class="list-name">{{garment.name}}</view>
        <view class="list-meta">穿衣参考 · {{garment.era}}</view>
      </view>
    </view>

    <view class="pill-btn garment-more" bindtap="signup">报名参加</view>
    <share-bar />
  </view>
</view>
<view class="page-stack" wx:else>
  <view class="empty">
    <view class="empty-title">找不到这个活动</view>
    <view class="empty-desc">链接可能失效了，点左上角返回</view>
  </view>
</view>
