<nav-bar title="出行服务" show-back="{{true}}"></nav-bar>
<view class="page-stack">
  <wxs src="../../utils/cdn.wxs" module="cdn" />
  <view class="page-inner">
    <view class="photo-band">
      <image src="{{cdn.url('banner-dunhuang.jpg')}}" mode="aspectFill" class="photo-fill" />
      <view class="photo-mask">
        <view class="photo-name">三地可组合</view>
        <view class="photo-meta">广州 · 桂林 · 敦煌</view>
      </view>
    </view>
    <view class="chip-row catalog-chips">
      <view
        wx:for="{{types}}"
        wx:key="id"
        class="chip {{current === item.id ? 'chip-on' : ''}}"
        bindtap="filter"
        data-type="{{item.id}}"
      >{{item.name}}</view>
    </view>
    <view class="page-sub service-hint">价格为门市价。选好日期后可模拟支付，年卡抵扣当场生效。</view>
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="list-row"
      bindtap="open"
      data-id="{{item.id}}"
    >
      <view class="thumb">
        <image src="{{cdn.url(item.photo)}}" mode="aspectFill" />
      </view>
      <view class="list-grow">
        <view class="list-name">{{item.name}}</view>
        <view class="list-meta">{{item.place}} · {{item.day}}</view>
      </view>
      <view class="list-price">
        {{item.price}}
        <text class="list-price-unit">{{item.price === '0' ? '免费' : '元起'}}</text>
      </view>
    </view>
    <share-bar />
  </view>
</view>
