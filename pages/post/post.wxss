.post-page { background: #fff; }

.post-cancel {
  min-width: 88rpx;
  min-height: 72rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: var(--ink-soft);
}

.post-publish {
  min-height: 64rpx;
  padding: 0 32rpx;
  border-radius: var(--radius-pill);
  background: linear-gradient(90deg, var(--brand-soft), var(--brand));
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.post-publish-off { opacity: 0.4; }

.post-body { padding: 12rpx 32rpx 48rpx; }

.post-textarea {
  width: 100%;
  min-height: 220rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--ink);
}

.post-count {
  margin-top: 8rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--ink-soft);
  font-variant-numeric: tabular-nums;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 24rpx 0;
}

.post-img-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.post-img-item image { width: 100%; height: 100%; }

.post-img-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.55);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.post-img-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #c5ccd3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--ink-soft);
}

.add-plus {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.add-plus::before,
.add-plus::after {
  content: "";
  position: absolute;
  background: currentColor;
  border-radius: 4rpx;
}

.add-plus::before {
  left: 50%;
  top: 4rpx;
  width: 4rpx;
  height: 28rpx;
  margin-left: -2rpx;
}

.add-plus::after {
  top: 50%;
  left: 4rpx;
  height: 4rpx;
  width: 28rpx;
  margin-top: -2rpx;
}

.add-text { font-size: 22rpx; margin-top: 8rpx; }

.post-types {
  display: flex;
  margin: 8rpx -8rpx 8rpx;
}

.post-type {
  flex: 1;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 8rpx;
  border-radius: var(--radius-pill);
  background: var(--paper-tint);
  font-size: 24rpx;
  color: var(--ink-soft);
}

.type-on {
  background: var(--wash);
  color: var(--brand-deep);
  font-weight: 700;
}

.post-loc {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding: 8rpx 0;
  border-top: 1rpx solid #eef1f2;
  color: var(--brand-deep);
  font-size: 28rpx;
  font-weight: 600;
}

.loc-pin {
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid currentColor;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}

.loc-text { transform: none; }
