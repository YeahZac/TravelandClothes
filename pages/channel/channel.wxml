<nav-bar title="{{title}}" show-back="{{true}}"></nav-bar>
<wxs src="../../utils/cdn.wxs" module="cdn" />
<view class="page-stack">
  <view class="page-inner">
    <view class="photo-band deal-hero">
      <image src="{{cdn.url(hero)}}" mode="aspectFill" class="photo-fill" />
      <view class="photo-mask">
        <view class="photo-name">{{heroName}}</view>
        <view class="photo-meta">{{heroMeta}}</view>
      </view>
    </view>
    <view wx:if="{{chips.length}}" class="chip-row catalog-chips">
      <view
        wx:for="{{chips}}"
        wx:key="*this"
        class="chip {{current === item ? 'chip-on' : ''}}"
        bindtap="filter"
        data-chip="{{item}}"
      >{{item}}</view>
    </view>

    <view wx:if="{{layout === 'deal'}}">
      <view
        wx:for="{{visible}}"
        wx:key="id"
        class="deal-card"
        hover-class="card-hover"
        bindtap="open"
        data-index="{{index}}"
      >
        <view class="deal-cover">
          <image src="{{cdn.url(item.photo)}}" mode="aspectFill" />
          <view wx:if="{{item.badge}}" class="deal-flag {{item.badge === '买贵赔' || item.badge === '价保' ? 'deal-flag-hot' : ''}}">{{item.badge}}</view>
          <view wx:if="{{item.sold}}" class="deal-sold-tag">{{item.price == '0' ? item.sold : ('已售' + item.sold)}}</view>
        </view>
        <view class="deal-main">
          <view class="deal-title-row">
            <text class="deal-title">{{item.name}}</text>
            <text wx:if="{{item.level}}" class="deal-level">{{item.level}}</text>
          </view>
          <view class="deal-score">
            <text class="deal-score-n">{{item.score}}</text>
            <text class="deal-score-m">{{item.reviews}}条评论</text>
            <text wx:if="{{item.crowd}}" class="deal-crowd">{{item.crowd}}</text>
          </view>
          <view wx:if="{{item.place}}" class="deal-loc">{{item.place}}</view>
          <view wx:if="{{item.tags && item.tags.length}}" class="deal-tags">
            <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="deal-tag">{{tag}}</text>
          </view>
          <view wx:if="{{item.rankLabel}}" class="deal-rank">{{item.rankLabel}}</view>
          <view wx:for="{{item.skus}}" wx:for-item="sku" wx:key="name" class="deal-sku">
            <text class="deal-sku-name">{{sku.name}}</text>
            <view class="deal-sku-prices">
              <text wx:if="{{sku.origin && sku.origin != sku.price && sku.price != '0'}}" class="deal-sku-origin">¥{{sku.origin}}</text>
              <text class="deal-sku-price">{{sku.price === '0' ? '免费' : ('¥' + sku.price)}}</text>
            </view>
          </view>
        </view>
        <view class="deal-aside">
          <view class="deal-price-line">
            <text wx:if="{{item.kind}}" class="deal-kind">{{item.kind}}</text>
            <text wx:if="{{item.price != '0'}}" class="deal-yen">¥</text>
            <text class="deal-price-n">{{item.price == '0' ? '免费' : item.price}}</text>
            <text wx:if="{{item.unit && item.price != '0'}}" class="deal-from">{{item.unit}}</text>
          </view>
          <view wx:if="{{item.off}}" class="deal-off">已减¥{{item.off}}</view>
        </view>
      </view>
    </view>

    <view wx:elif="{{layout === 'photo'}}">
      <view
        wx:for="{{visible}}"
        wx:key="id"
        class="photo-band"
        hover-class="card-hover"
        bindtap="open"
        data-index="{{index}}"
      >
        <image src="{{cdn.url(item.photo)}}" mode="aspectFill" class="photo-fill" />
        <view class="photo-mask">
          <view class="photo-name">{{item.name}}</view>
          <view class="photo-meta">{{item.meta}}</view>
        </view>
      </view>
    </view>
    <view wx:elif="{{layout === 'grid'}}" class="grid-2">
      <view
        wx:for="{{visible}}"
        wx:key="id"
        class="photo-tile catalog-tile"
        bindtap="open"
        data-index="{{index}}"
      >
        <image src="{{cdn.url(item.photo)}}" mode="aspectFill" class="photo-fill" />
        <view class="photo-mask">
          <view class="photo-name">{{item.name}}</view>
          <view class="photo-meta">{{item.meta}}</view>
        </view>
      </view>
    </view>
    <view wx:else>
      <view
        wx:for="{{visible}}"
        wx:key="id"
        class="list-row"
        hover-class="card-hover"
        bindtap="open"
        data-index="{{index}}"
      >
        <view class="thumb">
          <image src="{{cdn.url(item.photo)}}" mode="aspectFill" />
        </view>
        <view class="list-grow">
          <view class="list-name">{{item.name}}</view>
          <view class="list-meta">{{item.meta}}</view>
        </view>
        <view wx:if="{{item.price}}" class="list-price">
          {{item.price}}
          <text class="list-price-unit">{{item.price === '0' ? '免费' : '元'}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{!visible.length}}" class="empty">
      <view class="empty-title">这一栏还没有内容</view>
      <view class="empty-desc">换个分类，或稍后再看</view>
    </view>
  </view>
</view>
