.catalog-chips { margin: 8rpx 0 20rpx; }

.deal-hero {
  height: 240rpx;
}

.deal-card {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  background: var(--paper);
  border-radius: var(--radius-card);
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-soft);
}

.deal-cover {
  position: relative;
  width: 220rpx;
  min-height: 220rpx;
  align-self: stretch;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--wash);
}

.deal-cover image {
  width: 100%;
  height: 100%;
  display: block;
}

.deal-flag {
  position: absolute;
  left: 0;
  top: 0;
  padding: 4rpx 10rpx;
  background: var(--brand);
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  border-bottom-right-radius: 12rpx;
}

.deal-flag-hot {
  background: #e11d48;
}

.deal-sold-tag {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 6rpx 8rpx;
  background: rgba(26, 26, 46, 0.55);
  color: #fff;
  font-size: 18rpx;
}

.deal-main {
  flex: 1;
  min-width: 0;
  padding-top: 2rpx;
}

.deal-title-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.deal-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.deal-level {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--ink-soft);
  font-weight: 600;
}

.deal-score {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  color: var(--ink-soft);
}

.deal-score-n {
  color: #e85d04;
  font-size: 28rpx;
  font-weight: 800;
}

.deal-crowd {
  color: var(--brand-deep);
  font-weight: 600;
}

.deal-loc {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--ink-soft);
}

.deal-tags {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.deal-tag {
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: var(--wash);
  color: var(--brand-deep);
  font-size: 18rpx;
  font-weight: 600;
}

.deal-rank {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #c2410c;
  font-weight: 600;
}

.deal-sku {
  margin-top: 6rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12rpx;
  font-size: 20rpx;
  color: var(--ink-soft);
}

.deal-sku-name {
  flex: 1;
  min-width: 0;
}

.deal-sku-prices {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  flex-shrink: 0;
}

.deal-sku-origin {
  color: var(--ink-soft);
  text-decoration: line-through;
  font-size: 18rpx;
}

.deal-sku-price {
  color: var(--ink);
  font-weight: 700;
  flex-shrink: 0;
}

.deal-aside {
  width: 132rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: flex-start;
  padding-top: 4rpx;
}

.deal-price-line {
  display: flex;
  align-items: baseline;
  color: #e11d48;
  font-weight: 800;
  line-height: 1;
}

.deal-kind {
  margin-right: 4rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: var(--ink-soft);
}

.deal-yen {
  font-size: 20rpx;
}

.deal-price-n {
  font-size: 40rpx;
}

.deal-from {
  margin-left: 2rpx;
  font-size: 18rpx;
  font-weight: 600;
}

.deal-off {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #e11d48;
  font-weight: 700;
}

.deal-origin {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--ink-soft);
  text-decoration: line-through;
}
