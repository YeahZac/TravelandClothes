.msg-search { padding: 16rpx 32rpx 8rpx; }

.msg-shortcuts {
  display: flex;
  padding: 8rpx 16rpx 16rpx;
}

.shortcut-card {
  flex: 1;
  min-height: 168rpx;
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.shortcut-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}

.shortcut-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink);
  font-weight: 600;
}

.shortcut-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: #c44757;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.msg-tabs {
  display: flex;
  padding: 0 16rpx;
  margin-bottom: 8rpx;
}

.msg-tab {
  flex: 1;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-soft);
}

.msg-tab-on {
  color: var(--brand-deep);
  box-shadow: inset 0 -4rpx 0 var(--brand);
}

.chat-list,
.notice-list { padding: 0 32rpx; }

.chat-row,
.notice-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 128rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef1f2;
}

.chat-avatar {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: visible;
  flex-shrink: 0;
}

.chat-avatar image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.chat-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  background: #c44757;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  border: 3rpx solid #fff;
}

.notice-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.chat-info { flex: 1; min-width: 0; }

.chat-name { font-size: 30rpx; font-weight: 700; color: var(--ink); }

.chat-last {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-time { font-size: 22rpx; color: var(--ink-soft); flex-shrink: 0; }
