.grow-hero { text-align: center; }
.grow-num { font-size: 72rpx; font-weight: 800; color: var(--brand-deep); }
.grow-label { margin-top: 8rpx; font-size: 26rpx; color: var(--ink-soft); }
.growth-bar {
  margin: 20rpx auto 0;
  width: 80%;
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--wash);
  overflow: hidden;
}
.growth-fill { height: 100%; background: var(--brand); }

.ladder { margin: 28rpx 0 8rpx; padding-left: 12rpx; }
.ladder-item {
  display: flex;
  gap: 20rpx;
  padding: 12rpx 0 28rpx;
  border-left: 4rpx solid #e8ecee;
  margin-left: 10rpx;
  position: relative;
}
.ladder-item:last-child { border-left-color: transparent; padding-bottom: 0; }
.ladder-dot {
  position: absolute;
  left: -14rpx;
  top: 18rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #d5dce0;
}
.ladder-on .ladder-dot { background: var(--brand); }
.ladder-on .list-name { color: var(--brand-deep); }
