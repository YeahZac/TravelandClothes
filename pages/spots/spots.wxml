<view class="page">
  <wxs src="../../utils/cdn.wxs" module="cdn" />
  <view class="page-inner">
    <view class="photo-band spots-hero">
      <image src="{{cdn.url('/images/photo/banner-guilin.jpg')}}" mode="aspectFill" class="photo-fill" />
      <view class="photo-mask">
        <view class="photo-name">广州 · 桂林 · 敦煌</view>
        <view class="photo-meta">展览 · 打卡机位 · 换装</view>
      </view>
    </view>
    <view class="chip-row catalog-chips">
      <view
        wx:for="{{regions}}"
        wx:key="*this"
        class="chip {{current === item ? 'chip-on' : ''}}"
        bindtap="filter"
        data-region="{{item}}"
      >{{item}}</view>
    </view>
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="photo-band"
      bindtap="open"
      data-id="{{item.id}}"
    >
      <image src="{{item.photo}}" mode="aspectFill" class="photo-fill" />
      <view class="photo-mask">
        <view class="photo-name">{{item.name}}</view>
        <view class="photo-meta">{{item.city}} · 汉服打卡</view>
      </view>
    </view>
    <share-bar />
  </view>
</view>
