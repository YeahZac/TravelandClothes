flowchart TD
  subgraph S1["① 入会 · 攒成长值"]
    direction TB
    A1([访问小程序]) --> A2[浏览景区/活动]
    A2 --> A3[选择景区下单]
    A3 --> A4{支付成功}
    A4 -->|首次| A5[自动入会<br/>普通会员]
    A4 -->|非首次| A6[累计成长值<br/>1元=1值]
    A5 --> A6
    A6 --> A7{成长值达标?}
    A7 -->|未达标| A8[核销/打卡/邀请<br/>继续攒值]
    A8 --> A6
  end

  A7 -->|达标| B0

  subgraph S2["② 转化钩子 · 5场景触发"]
    direction TB
    B0[App提示<br/>已攒够X袍 购卡解锁] --> B1{触发场景}
    B1 --> C1[结算页<br/>本单立省X元]
    B1 --> C2[集章第3枚<br/>自动盖章+实体本]
    B1 --> C3[升级节点<br/>袍级权益对比]
    B1 --> C4[旺季预约失败<br/>预留配额先抢]
    B1 --> C5[汉服节报名<br/>现场专区+C位]
  end

  C1 --> D0
  C2 --> D0
  C3 --> D0
  C4 --> D0
  C5 --> D0

  subgraph S3["③ 购卡 · 解锁袍级"]
    direction TB
    D0{用户决策}
    D0 -->|9.9元试用7天| E1[享绿色通道/休息区<br/>不含免票]
    E1 --> E2{试用到期}
    E2 -->|转年卡| F1
    E2 -->|不转| F0[↻ 回普通会员<br/>成长值保留 继续①攒值]

    D0 -->|直接购年卡| F1[购买年卡<br/>399/299/999/企业款]
    F1 --> F2[年卡消费累计成长值<br/>399元=399值]
    F2 --> F3{按成长值<br/>解锁袍级}
    F3 -->|值小于300| G1[素袍会员]
    F3 -->|300至1000| G1
    F3 -->|1000至3000| G2[青袍会员]
    F3 -->|3000至8000| G3[玄袍会员]
    F3 -->|8000以上<br/>且集齐3线路| G4[金袍会员]
  end

  G1 --> H0
  G2 --> H0
  G3 --> H0
  G4 --> H0

  subgraph S4["④ 使用 · 续费 · 复购循环"]
    direction TB
    H0[激活袍级权益<br/>绿色通道/休息区/免票/联名/徽章]
    H0 --> H1[使用年卡核销<br/>景区/演出/租赁]
    H1 --> H2[每次核销+20值<br/>成长值继续累计]
    H2 --> H3{是否升档?}
    H3 -->|是| Z1[↻ 回到③<br/>重新判定袍级]
    H3 -->|否| H1

    H1 --> H4{年卡到期}
    H4 -->|用满80%| H5[续费8折]
    H4 -->|用满50%| H6[原价续费]
    H4 -->|不续费| H7[回普通会员<br/>成长值保留 徽章变灰]
    H5 --> H1
    H6 --> H1
    H7 --> H8{复购?}
    H8 -->|是| Z2[↻ 回到③<br/>重新购卡解锁]
    H8 -->|否| F0
  end
