.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  display: flex;
  align-items: stretch;
  height: calc(110rpx + env(safe-area-inset-bottom));
  padding: 0 0 env(safe-area-inset-bottom);
  box-sizing: content-box;
  background: #ffffff;
  box-shadow: 0 -4rpx 24rpx rgba(26, 26, 46, 0.06);
}

.tab-item {
  flex: 1;
  height: 110rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  padding-bottom: 12rpx;
  box-sizing: border-box;
}

.tab-hover { opacity: 0.7; }

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tab-badge {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c44757;
  border: 3rpx solid #fff;
}

.tab-text {
  margin: 0;
  font-size: 22rpx;
  line-height: 1.2;
  color: #5f6872;
  font-weight: 600;
}

.tab-on .tab-text { color: #1a9e8a; }

/* 图标统一 24 网格、1.8 描边，选中态只换颜色不换形状 */
.ico {
  width: 48rpx;
  height: 48rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

